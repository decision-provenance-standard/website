# Normalize text to LF so checksum files verify with `sha256sum -c` on all platforms.
* text=auto eol=lf
*.png binary
*.jpg binary
*.zip binary
*.docx binary
*.pdf binary

# Downloads are published byte for byte: their checksums cover the exact bytes.
# Git must never convert their line endings (the core Markdown uses CRLF).
docs/downloads/** -text
